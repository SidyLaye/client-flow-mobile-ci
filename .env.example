# Passed to the app with: flutter run --dart-define-from-file=.env
# Django REST backend shared with the cabinet desktop app.
#   - deployed:  https://test.allinone.ovh   (default when API_URL is not set)
#   - local LAN: http://192.168.1.42:8000     (Android also needs usesCleartextTraffic)
API_URL=https://test.allinone.ovh
# Seconds between checks for new messages / notifications on open screens.
POLL_SECONDS=10
# Firebase (push notifications) — Firebase console → Project settings → Your apps.
# Leave empty to disable push (or use google-services.json / GoogleService-Info.plist).
FIREBASE_PROJECT_ID=
FIREBASE_SENDER_ID=
FIREBASE_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=
