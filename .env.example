# Backend Django REST URL.
#
# - Local dev (Django runs on localhost via Docker or manage.py):
#     VITE_API_URL=http://localhost:8000
# - Staging / production (deployed Django, OVH):
#     VITE_API_URL=https://test.allinone.ovh
#
VITE_API_URL=https://test.allinone.ovh

