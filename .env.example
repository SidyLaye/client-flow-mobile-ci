# ─── Supabase ────────────────────────────────────────────────────────────────
# Find these on https://app.supabase.com/project/<your-project>/settings/api
#
# 1. Create a Supabase project (free tier is fine).
# 2. Apply the migrations in ./supabase/migrations  (npx supabase db push).
# 3. Deploy edge functions in ./supabase/functions  (npx supabase functions deploy).
# 4. Copy this file to .env and fill in the values below.

VITE_SUPABASE_URL="https://YOUR-PROJECT-ID.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR-ANON-KEY"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-ID"
